# =============================================================================
# Leader–Sub-Agent Multi-LLM Orchestration System — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values. Never commit .env to version control.
# API keys are read from environment variables at startup and held in memory only.

# ---- Application ----
APP_NAME=leader-subagent-orchestration
APP_ENV=production
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
WORKERS=1
DEBUG=false

# ---- PostgreSQL (Central Model Registry & audit logs) ----
DATABASE_URL=postgresql+psycopg2://orch_user:orch_pass@localhost:5432/orchestration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=orchestration
DB_USER=orch_user
DB_PASS=orch_pass

# ---- Redis (caching, rate limiting, shared task context) ----
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---- Qdrant (vector store / embeddings for research sub-agent) ----
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=research_embeddings

# ---- LLM Provider API Keys (store securely; never hardcode) ----
# Only set the keys for providers you actually use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
# Meta Llama / Mistral / DeepSeek / Qwen via OpenAI-compatible endpoints or direct providers
LLAMA_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=

# Optional OpenAI-compatible base URLs (for local models, Llama, etc.)
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1
LLAMA_BASE_URL=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# ---- Local model support (Ollama / llama.cpp / vLLM / TGI OpenAI-compatible) ----
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=

# ---- Security ----
ENCRYPTION_KEY=change-me-to-a-32-byte-base64-value-in-production
API_AUTH_TOKEN=change-me-in-production
SANDBOX_ENABLED=true
SANDBOX_TIMEOUT_SEC=30
SANDBOX_MAX_MEMORY_MB=512

# ---- Observability (OpenTelemetry) ----
OTEL_SERVICE_NAME=orchestration-system
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_LOG_LEVEL=INFO

# ---- Model Router defaults ----
DEFAULT_MAX_RETRIES=3
DEFAULT_REQUEST_TIMEOUT_SEC=120
DEFAULT_CONTEXT_BUDGET=4000
MAX_PARALLEL_SUBAGENTS=5

# ---- Quality Control ----
QUALITY_ENABLED=true
QUALITY_MIN_SCORE=0.7
QUALITY_MAX_REVIEW_ATTEMPTS=2