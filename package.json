{
  "name": "agi-super-harness",
  "productName": "Agi Super Harness",
  "version": "0.1.0",
  "description": "A desktop agent harness: a lead agent that plans, uses tools and delegates work to parallel sub-agents across workspaces.",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/agi-super-harness/desktop",
  "author": {
    "name": "Agi Super Harness",
    "email": "you@example.com"
  },
  "main": "dist/electron/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "node scripts/dev.mjs --web",
    "build": "vite build && node scripts/build-node.mjs",
    "start": "electron .",
    "serve": "node dist/server/server.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/build-node.mjs --tests && node --test \"dist/tests/*.test.cjs\"",
    "icons": "node scripts/export-icons.mjs",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.1.0",
    "@lydell/node-pty": "1.1.0"
  },
  "build": {
    "appId": "dev.agisuperharness.desktop",
    "productName": "Agi Super Harness",
    "asar": true,
    "directories": {
      "output": "out",
      "buildResources": "assets"
    },
    "files": [
      "dist/electron/**",
      "dist/renderer/**",
      "assets/icon.svg",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.svg",
      "target": ["dmg", "zip"]
    },
    "win": {
      "icon": "assets/icon.svg",
      "target": ["nsis"]
    },
    "linux": {
      "icon": "assets/icon.svg",
      "category": "Development",
      "target": ["AppImage", "deb"]
    }
  }
}
